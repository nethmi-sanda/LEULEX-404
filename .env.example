# ==============================================================================
# Image Studio - Backend Environment Configuration
# SECURITY: Never expose backend secrets (SESSION_SECRET, DB/S3 keys) to client/.
# ==============================================================================

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Session & CSRF security
SESSION_SECRET=replace-with-at-least-32-random-characters-in-dev
SESSION_COOKIE_NAME=imgstudio_sid
CSRF_COOKIE_NAME=imgstudio_csrf
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Persistence mode: "mongo" (production/docker) or "memory" (local fallback without MongoDB)
DB_MODE=mongo
MONGODB_URI=mongodb://127.0.0.1:27017/image_studio?replicaSet=rs0

# Object storage mode: "s3" (AWS S3 / MinIO / R2) or "local" (private local disk fallback for dev)
STORAGE_MODE=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=image-studio-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=./server/data/objects

# Quotas & limits
PER_ACCOUNT_STORAGE_QUOTA_BYTES=268435456
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# Frontend public configuration (Vite only exposes VITE_* vars to browser)
VITE_API_BASE_URL=http://localhost:4000/api
VITE_AUTOSAVE_DEBOUNCE_MS=1500

